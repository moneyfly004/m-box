# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# macOS 构建副产物（flutter build macos 生成，不入库：随 Podfile 变化而异，
# 提交它只会制造无意义的 diff）
macos/Podfile.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
dist/

# sing-box 内核库（CI 编译/下载，不入库）
android/app/libs/*.aar
android/app/libs/*.jar
singbox-bin/
# 内核二进制（桌面开发期下载）
.core_dl/

# 离线分流规则集（CI 构建时从 SagerNet/sing-geosite、sing-geoip 的 rule-set
# 分支下载，不在仓库里存；本地开发用 tool/fetch_ruleset.sh 获取）
assets/rules/*.srs

# ---- iOS ----
# 内核框架 ~100MB，不入库（构建前由 tool/fetch_singbox_ios.sh 生成）
ios/Libbox.xcframework/
# 扩展的规则集来自 assets/rules（构建期下载），不重复入库
ios/PacketTunnel/*.srs
ios/build/

# iOS 打包产物（IPA/Payload 是构建输出，不入库：上一次误提交把 ~150MB 二进制带进了仓库）
Payload/
dist-ios/
